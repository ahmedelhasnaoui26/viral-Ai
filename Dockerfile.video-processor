# Build video-processor from monorepo root (Railway Root Directory = empty / ".")
FROM node:20-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY services/video-processor/package.json ./
RUN npm install --omit=dev
COPY services/video-processor/src ./src

ENV PORT=8080
EXPOSE 8080
CMD ["node", "src/server.js"]
